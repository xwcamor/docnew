<!DOCTYPE html>
<html lang="<%= I18n.locale %>" data-scheme="<%= current_theme_scheme %>">
  <head>
    <title><%= content_for(:title) || t("app.name", default: "DOC APP") %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tokens", "fiori", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="shell">
      <header class="shell-bar">
        <span class="shell-bar__title"><%= current_setting&.app_name %></span>
        <span class="shell-bar__spacer"></span>
        <%= render "shared/locale_switcher" %>
        <%= render "shared/user_menu" %>
      </header>

      <nav class="sidebar"><%= render "shared/sidebar" %></nav>

      <main class="main">
        <%= render "shared/flash" %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
