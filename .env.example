APP_NAME="DOCUFIZ"
APP_ENV=local
APP_KEY=
APP_DEBUG=false #true para DebugBar
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
# daily + rotación (LOG_DAILY_DAYS=14 por defecto): sin esto, laravel.log crece
# sin límite y en el droplet termina comiéndose el disco.
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# To use MySQL instead, comment the block above and uncomment:
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=docapp
# DB_USERNAME=root
# DB_PASSWORD=

# Default: PostgreSQL 16+
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=docufiz
DB_USERNAME=laravel
DB_PASSWORD=

# ── La base del sistema anterior (v1, Ruby on Rails) ─────────────────────────
#
# De aqui lee `php artisan docufiz:migrate-data` para traerse empresas,
# personas, planes, aprobaciones y los formatos de obra. Es una conexion
# APARTE y de SOLO LECTURA: nada de lo que hace el sistema escribe en ella.
#
# Sin estas variables el sistema funciona igual; lo unico que no se puede
# hacer es la migracion (`setup:project --datos` avisa y sigue).
#
# En Laragon/XAMPP el usuario suele ser root sin clave. Apunta a una COPIA de
# la base de produccion, no a la de produccion.
LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=3306
LEGACY_DB_DATABASE=docapp
LEGACY_DB_USERNAME=root
LEGACY_DB_PASSWORD=

# ── Cual de las empresas del catalogo es la tuya ─────────────────────────────
#
# El numero de documento (RUC, RUT, NIT...) de la empresa que contrata: la del
# propio workspace, no las contratistas. De esto depende a quien se le pregunta
# que aprueba, porque quien autoriza un plan es de la que contrata.
#
# Se puede marcar tambien en Ajustes -> Mi empresa, pero `setup:project --datos`
# rehace la base y ese ajuste se pierde en cada carga. Aqui se queda.
#
# Va el DOCUMENTO y no el id: el id cambia con cada base y el documento no.
# Vacio, no se marca nada y se pregunta en la pantalla.
WORKSPACE_COMPANY_DOC=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# SESSION_SECURE_COOKIE no hace falta ponerla: fuera de `local` la aplicacion
# fuerza la cookie `secure` y el esquema https por su cuenta
# (AppServiceProvider::forzarHttpsFueraDeLocal). Se dejo de depender del .env
# porque un .env de produccion se escribe una vez y nadie lo vuelve a mirar.

# ── Plazos de conservacion de datos ───────────────────────────────────────────
# CUANTO se conserva cada cosa depende de la jurisdiccion del cliente, del tipo
# de obra y de sus contratos. No se decide en el codigo: se fija con quien lleve
# el asunto en casa del cliente y se escribe aqui. El razonamiento de cada plazo
# esta en config/purge.php.
#
# Catalogo (plantillas de formato, reglas de aprobacion): no documenta a nadie y
# borrarlo no destruye evidencia. Se vuelve a dar de alta y ya.
PURGE_DAYS_CATALOG=365
# Fichas de persona (nombre, documento, foto) y planes de trabajo (la evidencia
# de una jornada: quien estuvo, que se verifico, quien firmo). En 0 = NO SE
# PURGAN, y vienen asi a proposito: el defecto no puede ser un numero inventado.
PURGE_DAYS_PERSON_RECORD=0
PURGE_DAYS_WORK_EVIDENCE=0

# ── Historial de cambios (audit_logs) ─────────────────────────────────────────
# Tres relojes: a los 180 dias se vacia el CONTENIDO de la fila —los datos
# personales— conservando el rastro de quien hizo que y cuando; a los 365 se
# borra la fila de un cambio corriente; a los 1095, la de un acceso, una firma o
# un consentimiento. Los tres se ajustan tambien desde Ajustes, sin redeploy.
AUDIT_REDACT_AFTER_DAYS=180
AUDIT_RETENTION_DAYS=365
AUDIT_SECURITY_RETENTION_DAYS=1095

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# EMAIL Configuration — guia completa en docs/MAIL-SETUP.md
#MAIL_MAILER=log  # smtp en producción /log en desarrollo
MAIL_MAILER=log #smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME="hello@gmail.com"
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="hello@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

# Gootle Authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/auth/google/callback

# AWS Authentication
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Error tracking (opcional — solo en producción).
# Para activar: instalar `composer require sentry/sentry-laravel` y poner el
# DSN del proyecto Sentry. Si SENTRY_LARAVEL_DSN está vacío, Sentry se ignora
# silenciosamente — no envía ni rompe nada.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false

VITE_APP_NAME="${APP_NAME}"
# amCharts 5 (Charts) license key — se aplica del lado del cliente (am5.addLicense).
# La de Maps es aparte; el mapa del dashboard sigue en echarts.
VITE_AMCHARTS_LICENSE=

# ── Consultas a SUNAT y RENIEC (solo Perú) ───────────────────────────────────
#
# Un solo token para las dos consultas que hacía el sistema anterior:
#
#   - RUC en SUNAT   → rellena la razón social al dar de alta una empresa.
#   - DNI en RENIEC  → rellena nombre y apellidos al dar de alta una persona, y
#                      los deja bloqueados. Solo Perú y solo DNI: un carné de
#                      extranjería, un PTP o un pasaporte no están en RENIEC.
#
# OJO, HAY DOS PROVEEDORES Y NO HABLAN IGUAL. Ni la URL ni los nombres de los
# campos coinciden, así que poner el token de uno con el otro seleccionado
# devuelve un 401 y desde la pantalla parece que «la API no funciona»:
#
#   decolecta     api.decolecta.com   token `sk_...`   https://decolecta.com
#   apis_net_pe   api.apis.net.pe                      https://apis.net.pe
#
# Por defecto Decolecta, que es el que se usa. Si tu token es del otro, cambia
# también esta línea.
PERU_LOOKUP_PROVIDER=decolecta
PERU_LOOKUP_TOKEN=
# Cuanto se espera COMO MUCHO antes de rendirse y dejar escribir a mano. No es
# una espera: si contesta en medio segundo, tienes la respuesta en medio
# segundo. Solo se gasta entero cuando no llega nada. Decolecta puede tardar
# varios segundos, asi que un tope corto corta respuestas buenas.
PERU_LOOKUP_TIMEOUT=12
# Solo para apuntar a un espejo o a un doble en pruebas. En blanco se usa la del
# proveedor elegido.
PERU_LOOKUP_URL=
#
# Sin token no se consulta nada y todo se escribe a mano: NO es un error y no
# bloquea ningún alta.
